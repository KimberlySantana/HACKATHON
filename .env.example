# Supabase project configuration for group and expense cloud storage.
# This publishable key may be used in the browser; never put a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenAI Responses API key is server-only; used by POST /api/receipt/scan.
# Add your actual key only to ignored .env.local or Vercel's server environment.
OPENAI_API_KEY=
# Optional: defaults to gpt-5.4-mini.
OPENAI_RECEIPT_MODEL=gpt-5.4-mini

# Keep false in the MVP release. The server rejects paid scan requests unless exactly "true".
ENABLE_RECEIPT_SCANNING=false

# Reserved for a future Claude integration; the current scanner uses OpenAI.
ANTHROPIC_API_KEY=
